{
  "name": "myportofolio-theme",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "build:css": "npm run build",
    "start": "npm run watch",
    "watch": "tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --watch",
    "watch:css": "npm run watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  }
}
